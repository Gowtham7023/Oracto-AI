# ==============================================================================
# Oracto Environment Configuration Example
# Copy this file to .env and supply the relevant API keys and configuration.
# DO NOT commit .env containing sensitive API keys to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# Provider API Keys
# ------------------------------------------------------------------------------
# Google Gemini API key (for Gemini 3.8 Flash / Gemini 2.5 Flash models)
# Get a key at: https://aistudio.google.com/
GEMINI_API_KEY=

# Anthropic Claude API key (for Claude Sonnet 4.6 frontier models)
# Get a key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Ollama Base URL for local open-source models (Tier 1: Llama 3.2 3B, etc.)
# If running via Docker Compose, use host.docker.internal:
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# If running directly on the host machine:
OLLAMA_BASE_URL=http://localhost:11434

# ------------------------------------------------------------------------------
# Backend Configuration
# ------------------------------------------------------------------------------
DEBUG=true
ORACTO_DATABASE_URL=sqlite:///./oracto.db

# ------------------------------------------------------------------------------
# Frontend Configuration
# ------------------------------------------------------------------------------
# The base URL where the frontend communicates with the FastAPI backend
VITE_API_BASE_URL=http://localhost:8000/api/v1
